---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { getCollection } from 'astro:content'

const services = [
  {
    name: '博客',
    description: '文章、笔记与标签，技术实践与思考',
    url: 'http://39.105.76.239',
    icon: '📝',
  },
  {
    name: 'Cron Admin',
    description: '定时任务管理平台，统一调度与监控所有周期性任务',
    url: 'http://39.105.76.239:8001',
    icon: '⏱',
  },
  {
    name: 'Notes',
    description: '笔记页面，快速记录与查阅',
    url: 'http://39.105.76.239/notes',
    icon: '📓',
  },
]

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const recentPosts = allPosts.slice(0, 6)
---

<BaseLayout title="shhbase.cn">
  <div class="min-h-[calc(100vh-12rem)] flex flex-col items-center px-4 py-12 sm:py-16 lg:py-20">
    <!-- Hero -->
    <header class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 mb-4">
        shhbase<span class="text-blue-600">.cn</span>
      </h1>
      <p class="text-lg sm:text-xl text-gray-500 leading-relaxed">
        个人基础设施门户 — 聚合所有自托管服务，一站式导航与状态概览
      </p>
    </header>

    <!-- Service Cards -->
    <section class="w-full max-w-4xl mx-auto mb-16 sm:mb-20">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {
          services.map((svc) => (
            <a
              href={svc.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative bg-white border border-gray-200 rounded-2xl p-6 transition-all duration-200 hover:shadow-lg hover:border-blue-300 hover:-translate-y-0.5"
            >
              <div class="flex items-start justify-between mb-3">
                <span class="text-2xl">{svc.icon}</span>
                <svg class="h-4 w-4 text-gray-300 group-hover:text-blue-500 transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-1.5 group-hover:text-blue-600 transition-colors duration-200">
                {svc.name}
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed">{svc.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Recent Posts -->
    {
      recentPosts.length > 0 && (
        <section class="w-full max-w-4xl mx-auto">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-gray-900">最新文章</h2>
            <a href="/archive" class="text-sm text-gray-500 hover:text-blue-600 transition-colors">
              查看全部 →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {recentPosts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )
    }

    <!-- Footer -->
    <footer class="mt-16 sm:mt-20 text-center text-sm text-gray-400">
      <p>&copy; {new Date().getFullYear()} shhbase.cn — 个人基础设施门户</p>
    </footer>
  </div>
</BaseLayout>
