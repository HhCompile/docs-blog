---
import Icon from './Icon.astro'

export interface TaskOutput {
  id: number | string
  name: string
  description: string
  schedule?: string
  last_run?: string
  next_run?: string
  status: 'success' | 'failed' | 'running' | 'pending'
  output_summary?: string
}

export interface Props {
  task: TaskOutput
}

const { task } = Astro.props

const statusConfig = {
  success: { label: '成功', class: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300' },
  failed: { label: '失败', class: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300' },
  running: { label: '运行中', class: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300' },
  pending: { label: '待执行', class: 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400' },
}

const st = statusConfig[task.status]

function formatTime(iso?: string): string {
  if (!iso) return '-'
  const d = new Date(iso)
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
}
---

<article class="card group">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-2 min-w-0">
      <Icon name="list-todo" size={18} class="text-brand-600 flex-shrink-0" />
      <h2 class="text-lg font-bold truncate">{task.name}</h2>
    </div>
    <span class={`flex-shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ${st.class}`}>
      {st.label}
    </span>
  </div>

  {task.description && (
    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3">
      {task.description}
    </p>
  )}

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
    {task.schedule && (
      <span class="flex items-center gap-1">
        <Icon name="clock" size={12} />
        {task.schedule}
      </span>
    )}
    {task.last_run && (
      <span class="flex items-center gap-1">
        <Icon name="check-circle" size={12} />
        上次: {formatTime(task.last_run)}
      </span>
    )}
    {task.next_run && (
      <span class="flex items-center gap-1">
        <Icon name="calendar" size={12} />
        下次: {formatTime(task.next_run)}
      </span>
    )}
  </div>

  {task.output_summary && (
    <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-800">
      <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-3 font-mono">
        {task.output_summary}
      </p>
    </div>
  )}
</article>
